# Copy this file to .env and replace values with your local SQL Server connection strings.
# Never commit .env or real credentials.
BoardgameConnectionString=Server=(localdb)\MSSQLLocalDB;Database=BoardgameDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True
AuthDbConnectionString=Server=(localdb)\MSSQLLocalDB;Database=BoardgameAuthDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True
