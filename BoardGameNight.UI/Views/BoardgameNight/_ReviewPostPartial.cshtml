@model GameNightReviewViewModel

<div class="mb-3 border border-2 blackBorder">
    <div class="boardgameHeader p-2 text-white">
        <h5 class="card-title mb-0">Review toevoegen</h5>
    </div>
    <div class="card-body">
        <form asp-action="postReview" asp-controller="BoardgameNight" method="post">
            <input type="hidden" asp-for="BoardgameNightId" />

            <div class="form-group my-3">
                <label asp-for="Score" class="form-label text-white bold">Score</label>
                <div><span asp-validation-for="Score" class="text-danger "></span></div>
                <input min="1" max="5" asp-for="Score" class="form-control" />
            </div>

            <div class="form-group my-3">
                <label asp-for="ReviewDescription" class="text-white bold form-label">Beschrijving</label>
                <div><span asp-validation-for="ReviewDescription" class="text-danger"></span></div>
                <textarea asp-for="ReviewDescription" class="form-control"></textarea>
            </div>

            <button class="btn button w-100 mt-3" type="submit">Review plaatsen!</button>
        </form>
    </div>
</div>
