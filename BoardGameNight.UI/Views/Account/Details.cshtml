@{
    ViewData["Title"] = "Account Details";
}

@model UserViewModel

<div class="container mt-4">

    <div class="text-center mt-4 mb-4">
        <h1 class="d-inline border blackBorder border-2 backgroundHomeDarkBrown p-2">Account Details</h1>
    </div>

    <div class="account-details mx-auto w-50">
        <div class="p-4 blackBorder border border-3 backgroundHomeDarkBrown text-center">
            <div class="row mb-3">
                <p><span class="bold">Naam:</span> @Model.Name</p>
            </div>

            <div class="row mb-3">
                <p><span class="bold">Email:</span> @Model.Email</p>
            </div>


            <div class="row mb-3">
                <p><span class="bold">Geboortedatum:</span> @Model.BirthDate.ToString("dd MMMM yyyy")</p>
            </div>

            <div class="row mb-3">
                <p><span class="bold">Adres:</span> @Model.Address</p>
            </div>

            <div class="row mb-3">
                @if (Model.Gender == Gender.M)
                {
                    <p><span class="bold">Geslacht:</span> Man</p>
                }
                else if (Model.Gender == Gender.F)
                {
                    <p><span class="bold">Geslacht:</span> Vrouw</p>
                }
                else
                {
                    <p><span class="bold">Geslacht:</span> Onbekent</p>
                }
            </div>

            <div class="row mb-3">
                <p><span class="bold">Heeft noten allergie:</span> @(Model.HasNutAllergy ? "Ja" : "Nee")</p>
            </div>

            <div class="row mb-3">
                <p><span class="bold">Is lactose intolerant:</span> @(Model.IsLactoseIntolerant ? "Ja" : "Nee")</p>
            </div>

            <div class="row mb-3">
                <p><span class="bold">Is vegetarisch:</span> @(Model.IsVegetarian ? "Ja" : "Nee")</p>
            </div>

            <div class="row">
                <p><span class="bold">Drinkt alcohol:</span> @(Model.DrinksAlcohol ? "Ja" : "Nee")</p>
            </div>
        </div>
        <div class="mt-2 text-end">
            <a asp-action="logout" asp-controller="Account" class="btn btn-danger text-uppercase">
                <i class="fas fa-sign-out-alt"></i> Uitloggen
            </a>
        </div>
    </div>
</div>
